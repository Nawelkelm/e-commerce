# =============================================================================
#  Archivo de ejemplo LEGADO — usar el .env.example de la RAÍZ del proyecto.
#  Este archivo se mantiene solo por compatibilidad con scripts que lo busquen aquí.
#  Ver ../.env.example para la lista completa y actualizada de variables.
# =============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=production
PORT=5000

# --- Base de datos (PostgreSQL) --------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- JWT -------------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=7d

# --- Dominios / URLs -------------------------------------------------------
FRONTEND_URL=https://www.tu-dominio.com
BACKEND_URL=https://api.tu-dominio.com
CORS_ORIGINS=https://www.tu-dominio.com,https://tu-dominio.com

# --- MercadoPago -----------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# --- Cloudinary ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Email / SMTP ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- AFIP ------------------------------------------------------------------
AFIP_CUIT=your_company_cuit
AFIP_CERT_PATH=./certs/cert.pem
AFIP_KEY_PATH=./certs/key.pem
AFIP_PRODUCTION=false

# --- Logística: OCA --------------------------------------------------------
OCA_API_URL=https://webservice.oca.com.ar/epak_tracking/Oep_TrackEPak.asmx
OCA_CUIT=your_company_cuit
OCA_PASSWORD=your_oca_password
OCA_ORIGIN_POSTAL_CODE=3300
OCA_OPERATIVA=467730

# --- Logística: Andreani / Correo Argentino --------------------------------
ANDREANI_API_URL=https://api.andreani.com/v2
ANDREANI_USERNAME=your_andreani_username
ANDREANI_PASSWORD=your_andreani_password
ANDREANI_CONTRACT=your_contract_number
CORREO_ARGENTINO_API_URL=https://api.correoargentino.com.ar
CORREO_ARGENTINO_API_KEY=your_correo_argentino_api_key
CORREO_ARGENTINO_CLIENT_ID=your_client_id
