# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres123

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Server
PORT=5000
NODE_ENV=development

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# AFIP Configuration
AFIP_CUIT=your_company_cuit
AFIP_PRODUCTION=false
AFIP_CERT_PATH=./certs/cert.pem
AFIP_KEY_PATH=./certs/key.pem

# Andreani API Configuration
ANDREANI_API_URL=https://api.andreani.com/v2
ANDREANI_USERNAME=your_andreani_username
ANDREANI_PASSWORD=your_andreani_password
ANDREANI_CONTRACT=your_contract_number

# OCA API Configuration
OCA_API_URL=https://webservice.oca.com.ar/epak_tracking/Oep_TrackEPak.asmx
OCA_CUIT=your_company_cuit
OCA_OPERATIVA=your_operativa_code
OCA_PASSWORD=your_oca_password

# Correo Argentino API Configuration
CORREO_ARGENTINO_API_URL=https://api.correoargentino.com.ar
CORREO_ARGENTINO_API_KEY=your_correo_argentino_api_key
CORREO_ARGENTINO_CLIENT_ID=your_client_id

# Logistics Sync Settings
LOGISTICS_SYNC_ENABLED=true
LOGISTICS_SYNC_INTERVAL=30
