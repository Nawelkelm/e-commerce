# ============================================================================
#  E-COMMERCE — Variables de entorno (ejemplo)
#  Copiar a .env y completar. NUNCA commitear el .env real.
#  En Coolify: cargar estas variables en la sección "Environment Variables".
# ============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=production
PORT=5000

# --- Base de datos (PostgreSQL) --------------------------------------------
# DATABASE_URL es OBLIGATORIA. Ya no hay fallback hardcodeado.
# En Coolify se autogenera al crear el recurso PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=ecommerce
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
# SSL hacia la DB. En producción gestionada normalmente true.
DB_SSL=true
# true para validar el certificado de la CA (recomendado si el proveedor expone CA válida).
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Redis (cache + colas Bull) --------------------------------------------
# En Coolify se autogenera al crear el recurso Redis.
REDIS_URL=redis://redis:6379

# --- JWT --------------------------------------------------------------------
# Generar con: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=7d

# --- Dominios / URLs --------------------------------------------------------
FRONTEND_URL=https://www.tu-dominio.com
BACKEND_URL=https://api.tu-dominio.com
# Lista separada por comas de orígenes permitidos por CORS.
# Si se omite, se usan FRONTEND_URL + BACKEND_URL + localhost:3000.
CORS_ORIGINS=https://www.tu-dominio.com,https://tu-dominio.com
# URL del API para el frontend (build de Vite).
VITE_API_URL=https://api.tu-dominio.com/api

# --- MercadoPago ------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# --- Cloudinary (imágenes) --------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Email / SMTP -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- Seguridad / Rate limiting ---------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_SESSION_SECRET
CSRF_SECRET=CHANGE_THIS_TO_RANDOM_CSRF_SECRET

# --- Logística: OCA ---------------------------------------------------------
# (NO duplicar estas claves; los duplicados con placeholder rompen la integración)
OCA_API_URL=https://webservice.oca.com.ar/epak_tracking/Oep_TrackEPak.asmx
OCA_CUIT=your_company_cuit
OCA_PASSWORD=your_oca_password
OCA_ORIGIN_POSTAL_CODE=3300
ORIGIN_POSTAL_CODE=3300
# Operativas: 467730=PaP, 467731=PaS, 467732=SaP, 467733=SaS
OCA_OPERATIVA=467730
OCA_OPERATIVA_P2P=467730
OCA_OPERATIVA_P2S=467731
OCA_OPERATIVA_S2P=467732
OCA_OPERATIVA_S2S=467733
LOGISTICS_SYNC_ENABLED=true
LOGISTICS_SYNC_INTERVAL=30

# --- Logística: Andreani / Correo Argentino (opcional) ---------------------
ANDREANI_API_URL=https://api.andreani.com/v2
ANDREANI_USERNAME=your_andreani_username
ANDREANI_PASSWORD=your_andreani_password
ANDREANI_CONTRACT=your_contract_number
CORREO_ARGENTINO_API_URL=https://api.correoargentino.com.ar
CORREO_ARGENTINO_API_KEY=your_correo_argentino_api_key
CORREO_ARGENTINO_CLIENT_ID=your_client_id

# --- AFIP (facturación electrónica) ----------------------------------------
AFIP_CUIT=your_company_cuit
AFIP_CERT_PATH=./certs/cert.pem
AFIP_KEY_PATH=./certs/key.pem
AFIP_PRODUCTION=false

# --- Uploads ----------------------------------------------------------------
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5000000
