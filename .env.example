# Environment Variables
NODE_ENV=production

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!@#

# JWT Configuration (CRITICAL: Change these to random 64+ character strings)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_FOR_ACCESS_TOKENS
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING_FOR_REFRESH
JWT_REFRESH_EXPIRES_IN=7d

# MercadoPago Configuration
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Server Configuration
PORT=5000
FRONTEND_URL=https://e-commerce-frontend-rlvt.onrender.com
BACKEND_URL=https://e-commerce-7q25.onrender.com

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_SESSION_SECRET_64_CHARS
CSRF_SECRET=CHANGE_THIS_TO_RANDOM_CSRF_SECRET_64_CHARS

# Email Configuration (for password recovery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5000000